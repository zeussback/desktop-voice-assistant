# Desktop Voice Assistant Environment Variables
# Google Gemini API Key (Almak için: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Kısayol Tuşu (Toggle)
HOTKEY=ctrl+space

# Yerel LLM Fallback (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Yerel TTS Motoru (VoiceStudio)
VOICESTUDIO_BASE_URL=http://localhost:3900
VOICESTUDIO_DEFAULT_VOICE=

# Yedek TTS Motoru (Edge-TTS)
FALLBACK_TTS_VOICE=tr-TR-AhmetNeural
